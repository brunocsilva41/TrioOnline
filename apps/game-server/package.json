{
  "name": "game-server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev -r tsconfig-paths/register src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "prestart": "pnpm --filter db run db:migrate:deploy",
    "start": "node dist/index.js",
    "db:generate": "pnpm --filter db run db:generate"
  },
  "dependencies": {
    "@colyseus/redis-driver": "^0.17.7",
    "@colyseus/redis-presence": "^0.17.7",
    "@colyseus/schema": "^2.0.0",
    "@colyseus/ws-transport": "^0.15.0",
    "@prisma/client": "5.22.0",
    "@trinity/core-engine": "workspace:*",
    "@types/express": "^4.17.0",
    "@types/node": "^18.0.0",
    "@types/uuid": "^9.0.0",
    "colyseus": "^0.15.0",
    "cors": "^2.8.5",
    "db": "workspace:*",
    "express": "^4.18.0",
    "ioredis": "^5.11.1",
    "prisma": "5.22.0",
    "prom-client": "^15.0.0",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^3.15.0",
    "typescript": "^5.0.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  }
}
